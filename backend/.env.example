# Copy this file to .env and fill in the values

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Any long random string, used to sign login tokens
JWT_SECRET=change-me

# Frontend URLs allowed by CORS (comma-separated, no trailing slash)
ORIGINS=http://localhost:5173

# Port the API and Socket.IO server run on
PORT=5000

# Cloudinary, where uploaded study material PDFs are stored
# (cloudinary.com dashboard -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
