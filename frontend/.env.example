# Copy this file to .env

# Backend server URL (API and Socket.IO), no trailing slash
VITE_BASE_URL=http://localhost:5000

# AI service URL (FastAPI), no trailing slash
VITE_AI_URL=http://localhost:8000

# Optional TURN server for video calls on strict networks (e.g. from metered.ca)
# Several URLs can be comma-separated
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
